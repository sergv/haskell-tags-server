cabal-version: 3.0

name:
  faster-richer-tags
version:
  0.1
synopsis:
  Server that looks up haskell entities, similar to tags in editors but more precise
license:
  Apache-2.0
author:
  Sergey Vinokurov
maintainer:
  serg.foo@gmail.com
category:
  Development
build-type:
  Simple

flag dev
  description:
    Enable development aids
  default:
    False
  manual:
    True

common ghc-options
  default-language:
    GHC2021

  default-extensions:
    LambdaCase

  ghc-options:
    -Weverything
    -Wno-all-missed-specialisations
    -Wno-implicit-prelude
    -Wno-missed-specialisations
    -Wno-missing-import-lists
    -Wno-missing-local-signatures
    -Wno-safe
    -Wno-unsafe

  if impl(ghc >= 8.8)
    ghc-options:
      -Wno-missing-deriving-strategies

  if impl(ghc >= 8.10)
    ghc-options:
      -Wno-missing-safe-haskell-mode
      -- -Wno-prepositive-qualified-module

  if impl(ghc >= 9.2)
    ghc-options:
      -Wno-missing-kind-signatures

  if impl(ghc >= 9.8)
    ghc-options:
      -Wno-missing-role-annotations
      -Wno-missing-poly-kind-signatures

library
  if flag(dev)
    cpp-options: -DDEVELOPMENT
  if os(windows)
    build-depends: unix-compat
  else
    build-depends: unix >= 2.6, unix-compat

  mixins:
    fast-tags hiding ( System.OsPath.Ext )

  build-depends:
    , abstract-par
    , array
    , async
    , attoparsec >= 0.13.1.0
    , base >= 4
    , bimap
    , bytestring
    , conduit
    , conduit-extra
    , containers
    , deepseq
    , directory
    , dlist
    , emacs-native
    , exceptions >= 0.8
    , extra >= 1.4.2
    , fast-tags >= 1.3
    , filepath
    , hashable
    , haskell-src-exts >= 1.16
    , lifted-async
    , microlens
    , monad-control >= 1.0
    , monad-par
    , monad-par-extras
    , mtl >= 2.2
    , network >= 2.6
    , parallel
    , pointed
    , prettyprinter
    , prettyprinter-combinators
    , profunctors >= 5.2
    , regex-tdfa >= 1.2.2
    , scientific
    , semigroupoids
    , semigroups
    , sexp-grammar
    , stm
    , stm-chans
    , store
    , streaming-commons
    , text
    , time
    , transformers
    , transformers-base
    , unordered-containers
    , unsafe
    , utf8-string >= 0.3
  exposed-modules:
    Control.Arrow.Ext
    Control.Monad.Ext
    Control.Monad.ErrorExcept
    Control.Monad.Except.Ext
    Control.Monad.Filesystem
    Control.Monad.Logging
    Control.Monad.Logging.Simple
    Control.Monad.Par.Combinator.Ext
    Control.Parallel.Strategies.Ext

    Data.CompiledRegex
    Data.Condition
    Data.ErrorMessage
    Data.Foldable.Ext
    Data.HasLens
    Data.IgnoreEqOrdHashNFData
    Data.KeyMap
    Data.Map.NonEmpty
    Data.MonoidalMap
    Data.Path
    Data.Promise
    Data.SubkeyMap
    Data.SymbolMap
    Data.Symbols
    Data.Symbols.MacroName

    FasterRicherTags.Types

    GHC.Stack.Ext

    Haskell.Language.LexerSimple.LensBlaze
    Haskell.Language.LexerSimple.Lexer
    Haskell.Language.LexerSimple.Types

    Haskell.Language.Lexer
    Haskell.Language.Lexer.FastTags
    Haskell.Language.Lexer.Types

    Haskell.Language.Lexer.Env
    Haskell.Language.Lexer.InputStack
    Haskell.Language.Lexer.Input
    Haskell.Language.Lexer.Lexer
    Haskell.Language.Lexer.Monad
    Haskell.Language.Lexer.Preprocessor
    Haskell.Language.Lexer.RulePredicate
    Haskell.Language.Lexer.State

    Haskell.Language.Server.Sexp
    Haskell.Language.Server.Tags
    Haskell.Language.Server.Tags.AnalyzeHeader
    Haskell.Language.Server.Tags.LoadFiles
    Haskell.Language.Server.Tags.Types
    Haskell.Language.Server.Tags.Types.Imports
    Haskell.Language.Server.Tags.Types.Modules

    Prettyprinter.Ext
  other-modules:
    Control.Monad.EitherCPS

    Data.Filesystem
    Data.NBSem
    Data.Path.Internal
    Data.Strict.Pair

    Haskell.Language.Server.Tags.LoadModule
    Haskell.Language.Server.Tags.Search
    Haskell.Language.Server.Tags.SearchM
  hs-source-dirs:
    src
  default-language:
    Haskell2010
  ghc-options:
    -Wall
    -Werror
    -fno-warn-type-defaults
    -fno-warn-name-shadowing
  if impl(ghc >= 8.0)
    ghc-options:
      -Wcompat
  build-tool-depends:
    alex:alex >= 3.1.7

executable faster-richer-tags
  import: ghc-options
  main-is:
    exe/FasterRicherTagsMain.hs
  other-modules:
    FasterRicherTags.CompactFormat
  hs-source-dirs:
    .
    exe
  build-depends:
    , base >= 4.16
    , bytestring
    , containers
    , directory
    , directory-ospath-streaming
    , emacs-native
    , file-io
    , filepath >= 1.4.100
    , ghc-prim
    , mtl
    , optparse-applicative
    , prettyprinter
    , prettyprinter-combinators
    , text
    , faster-richer-tags
  ghc-options:
    -rtsopts
    -- -threaded
    -- "-with-rtsopts=-N -A32M"
    -main-is FasterRicherTagsMain

executable haskell-tags-server
  if !os(windows)
    build-depends: unix >= 2.6
  main-is:
    exe/HaskellTagsServerMain.hs
  build-depends:
    , base
    , containers
    , directory
    , filepath
    , faster-richer-tags
    , mtl
    , network
    , optparse-applicative
    , text
  default-language:
    Haskell2010
  ghc-options:
    -Wall
    -fno-warn-type-defaults
    -fno-warn-name-shadowing
    -rtsopts
    -threaded
    "-with-rtsopts=-N"
    -main-is HaskellTagsServerMain
  if impl(ghc >= 8.0)
    ghc-options:
      -Wcompat

test-suite test-haskell-tags-server
  if !os(windows)
    build-depends: unix >= 2.6
  default-language:
    Haskell2010
  type:
    exitcode-stdio-1.0
  hs-source-dirs:
    tests
  main-is:
    Main.hs
  other-modules:
    Control.Monad.Logging.DiscardLogs
    Data.Map.NonEmpty.Tests
    Haskell.Language.Lexer.Preprocessor.Tests
    Haskell.Language.Lexer.Tests
    Haskell.Language.Lexer.Tokenisation
    Haskell.Language.Lexer.TokenisationUtils
    Haskell.Language.Server.Tags.AnalyzeHeaderTests
    Haskell.Language.Server.Tags.AnalyzeHeaderTests.Regressions
    Haskell.Language.Server.Tags.TypesTests
    PortPool
    ServerTests
    ServerTests.Data
    ServerTests.LogCollectingServer
    TestUtils
  build-depends:
    , QuickCheck
    , base
    , bytestring
    , containers
    , deepseq
    , directory
    , dlist
    , exceptions
    , fast-tags
    , faster-richer-tags
    , filepath
    , monad-control
    , mtl
    , network
    , prettyprinter
    , raw-strings-qq
    , regex-tdfa
    , scientific
    , semigroups
    , sexp-grammar
    , stm
    , tasty >= 0.7
    , tasty-hunit >= 0.4
    , tasty-quickcheck
    , template-haskell
    , text
    , transformers
    , transformers-base
    , utf8-string
  ghc-options:
    -Wall
    -fno-warn-type-defaults
    -fno-warn-name-shadowing
    -rtsopts
    -threaded
    "-with-rtsopts=-A32m -N"
  if impl(ghc >= 8.0)
    ghc-options:
      -Wcompat
